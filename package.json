{
  "name": "yui-live-kit",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib && cargo build --manifest-path src-tauri/Cargo.toml --examples && node --test tests/",
    "test:perf": "cargo test --manifest-path src-tauri/Cargo.toml --release --lib -- --ignored --nocapture",
    "release": "tauri build && node scripts/package-release.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright": "^1.65.0"
  }
}
