{
  "name": "yui-live-kit",
  "version": "2026.1108.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 && node scripts/write-checksums.cjs",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test tests/*.test.js",
    "build:translation": "node scripts/build-translation.cjs",
    "build:subtitles": "node scripts/build-subtitles.cjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "com.suzunayui.yuilivekit",
    "productName": "YuiLiveKit",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "translation/icon.ico",
      "signExecutable": false
    },
    "files": [
      "*.js",
      "*.html",
      "translation/**",
      "subtitles/**",
      "runtime/**",
      "package.json",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "LICENSE",
      "README.md"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "obs-websocket-js": "^5.0.8"
  }
}
