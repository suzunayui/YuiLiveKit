{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuiLiveKit",
  "mainBinaryName": "YuiLiveKit",
  "version": "2026.1108.4",
  "identifier": "com.suzunayui.yuilivekit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YuiLiveKit",
        "width": 960,
        "height": 640,
        "minWidth": 520,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:50021 https://*.ggpht.com https://*.googleusercontent.com https://*.ytimg.com https://static-cdn.jtvnw.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../python/": "python/"
    }
  }
}